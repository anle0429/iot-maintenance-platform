{
  "format": "iot-deployment-request-v1",
  "kind": "kubernetes",
  "manifest": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "iot-log-discovery-probe",
      "namespace": "iot-features"
    },
    "spec": {
      "replicas": 1,
      "strategy": {
        "type": "Recreate"
      },
      "selector": {
        "matchLabels": {
          "app": "iot-log-discovery-probe"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "iot-log-discovery-probe"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "securityContext": {
            "runAsNonRoot": true,
            "runAsUser": 10001,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "containers": [
            {
              "name": "probe",
              "image": "iot-coursework-predictor:observe-jenkins-2",
              "imagePullPolicy": "Never",
              "command": [
                "python",
                "-c",
                "import json,os,time;[print(json.dumps({'experiment':'iot-log-discovery-28','batch':os.environ['BATCH'],'sequence':i,'pod_uid':os.environ['POD_UID']}),flush=True) for i in range(20)];time.sleep(10800)"
              ],
              "env": [
                {
                  "name": "BATCH",
                  "value": "second"
                },
                {
                  "name": "POD_UID",
                  "valueFrom": {
                    "fieldRef": {
                      "fieldPath": "metadata.uid"
                    }
                  }
                }
              ],
              "resources": {
                "requests": {
                  "cpu": "10m",
                  "memory": "32Mi"
                },
                "limits": {
                  "cpu": "100m",
                  "memory": "128Mi"
                }
              },
              "securityContext": {
                "readOnlyRootFilesystem": true,
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  },
  "artifact_sha256": "60dff76d4d27a9e248bc08a80c4da80a3212701774c00f89f0b16139e1609981",
  "context_protocol_sha256": "e0bfcea57331b88bb6914f9342a9477eab6687f6a3929b8cb9834251fa9b8a96",
  "observation": {
    "manifest_parent": "docs/evidence/log-discovery-linux/check-v3/second-deployment.json",
    "manifest_parent_sha256": "34860b41b9147efb4e3820904155d462eef968289e64be90d3e3d9a8b1999160",
    "scope": "Actual controlled log probe template plus genuine approved model6 release envelope. Policy test only; no deployment command."
  }
}
