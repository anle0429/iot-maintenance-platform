                                                                            "type": "string"
                                                                        },
                                                                        "maxItems": 16,
                                                                        "type": "array"
                                                                    },
                                                                    "notTrustDomains": {
                                                                        "description": "Optional.",
                                                                        "items": {
                                                                            "type": "string"
                                                                        },
                                                                        "type": "array"
                                                                    },
