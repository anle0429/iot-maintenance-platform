                                        "maxItems": 4096,
                                        "type": "array"
                                    },
                                    "exportTo": {
                                        "description": "A list of namespaces to which this service is exported.",
                                        "items": {
                                            "type": "string"
                                        },
                                        "type": "array"
                                    },
                                    "hosts": {
                                        "description": "The hosts associated with the ServiceEntry.",
