                                        "message": "DNS_ROUND_ROBIN mode cannot have multiple endpoints",
                                        "rule": "((has(self.resolution) ? self.resolution : \"\") == \"DNS_ROUND_ROBIN\") ? ((has(self.endpoints) ? self.endpoints : []).size() \u003c= 1) : true"
                                    }
                                ]
