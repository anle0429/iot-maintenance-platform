                                                                        "items": {
                                                                            "type": "string"
                                                                        },
                                                                        "type": "array"
                                                                    },
                                                                    "notRequestPrincipals": {
                                                                        "description": "Optional.",
                                                                        "items": {
                                                                            "type": "string"
                                                                        },
                                                                        "type": "array"
                                                                    },
                                                                    "notServiceAccounts": {
                                                                        "description": "Optional.",
                                                                        "items": {
