                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "required": [
                                            "provider"
                                        ]
                                    }
                                ],
                                "properties": {
                                    "action": {
                                        "description": "Optional.\n\nValid Options: ALLOW, DENY, AUDIT, CUSTOM",
                                        "enum": [
                                            "ALLOW",
                                            "DENY",
                                            "AUDIT",
                                            "CUSTOM"
                                        ],
                                        "type": "string"
                                    },
