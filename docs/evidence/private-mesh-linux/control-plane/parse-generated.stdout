                                                                "oneOf": [
                                                                    {
                                                                        "not": {
                                                                            "anyOf": [
                                                                                {
                                                                                    "required": [
                                                                                        "exact"
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "required": [
                                                                                        "prefix"
                                                                                    ]
                                                                                },
                                                                                {
