{
  "name": "iot-coursework-ingest",
  "networks": {
    "default": {
      "name": "iot-coursework-ingest_default",
      "ipam": {}
    }
  },
  "services": {
    "ingest": {
      "cpus": 6,
      "command": null,
      "entrypoint": null,
      "environment": {
        "SPARK_LOCAL_IP": "0.0.0.0"
      },
      "image": "iot-coursework-spark:3.5.9",
      "mem_limit": "30064771072",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/srv/iot-data/workspace/iot-maintenance-platform/pipelines",
          "target": "/workspace/pipelines",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/srv/iot-data/workspace/iot-maintenance-platform/generator",
          "target": "/workspace/generator",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/srv/iot-data/workspace/iot-maintenance-platform/data",
          "target": "/workspace/data",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/srv/iot-data/workspace/iot-maintenance-platform/outputs",
          "target": "/workspace/outputs",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/srv/iot-data/spark-scratch/scale-ingest-100gb-27",
          "target": "/scratch"
        }
      ],
      "build": {
        "context": "/srv/iot-data/workspace/iot-maintenance-platform/infra/spark",
        "dockerfile": "Dockerfile"
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 4040,
          "published": "14040",
          "protocol": "tcp"
        }
      ]
    }
  }
}