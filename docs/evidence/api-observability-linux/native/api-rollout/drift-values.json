{
  "autoscaling": {
    "enabled": true,
    "maxReplicas": 2,
    "minReplicas": 1,
    "targetCPUUtilizationPercentage": 60
  },
  "env": [
    {
      "name": "IOT_DRIFT_REFERENCE",
      "value": "/reference/reference.json"
    },
    {
      "name": "IOT_DRIFT_DATABASE",
      "value": "/state/windows.db"
    },
    {
      "name": "IOT_API_SERVICE",
      "value": "drift"
    },
    {
      "name": "IOT_TRACE_ENDPOINT",
      "value": "http://iot-jaeger.iot-observability.svc.cluster.local:4318/v1/traces"
    }
  ],
  "image": {
    "pullPolicy": "Never",
    "repository": "iot-coursework-drift-api",
    "tag": "observe-28b-v2"
  },
  "initContainers": [],
  "replicas": 1,
  "resources": {
    "limits": {
      "cpu": "1",
      "memory": "512Mi"
    },
    "requests": {
      "cpu": "100m",
      "memory": "128Mi"
    }
  },
  "revisionMarker": "observability-28b-v2",
  "volumeMounts": [
    {
      "mountPath": "/reference",
      "name": "reference",
      "readOnly": true
    },
    {
      "mountPath": "/state",
      "name": "state"
    },
    {
      "mountPath": "/tmp",
      "name": "tmp"
    }
  ],
  "volumes": [
    {
      "configMap": {
        "name": "iot-drift-reference-v1"
      },
      "name": "reference"
    },
    {
      "name": "state",
      "persistentVolumeClaim": {
        "claimName": "iot-drift-assessments-v1"
      }
    },
    {
      "emptyDir": {
        "medium": "Memory",
        "sizeLimit": "32Mi"
      },
      "name": "tmp"
    }
  ]
}
