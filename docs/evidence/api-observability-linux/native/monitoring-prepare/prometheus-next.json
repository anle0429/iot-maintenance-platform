{
  "global": {
    "scrape_interval": "2s",
    "scrape_timeout": "1s",
    "evaluation_interval": "2s"
  },
  "scrape_configs": [
    {
      "job_name": "iot-host",
      "sample_limit": 5000,
      "file_sd_configs": [
        {
          "files": [
            "/srv/iot-data/workspace/iot-maintenance-platform/data/runtime/monitoring-28/targets/host.json"
          ],
          "refresh_interval": "2s"
        }
      ],
      "metric_relabel_configs": [
        {
          "source_labels": [
            "__name__"
          ],
          "regex": "node_cpu_seconds_total|node_memory_MemAvailable_bytes|node_memory_MemTotal_bytes|node_filesystem_avail_bytes|node_filesystem_size_bytes|node_disk_read_bytes_total|node_disk_written_bytes_total|node_network_receive_bytes_total|node_network_transmit_bytes_total|node_scrape_collector_success|node_exporter_build_info",
          "action": "keep"
        }
      ]
    },
    {
      "job_name": "iot-offline-drift-gateway",
      "honor_labels": true,
      "sample_limit": 100,
      "static_configs": [
        {
          "targets": [
            "127.0.0.1:19092"
          ]
        }
      ],
      "metric_relabel_configs": [
        {
          "source_labels": [
            "__name__"
          ],
          "regex": "iot_offline_drift_.*|push_time_seconds|push_failure_time_seconds|pushgateway_build_info",
          "action": "keep"
        }
      ]
    },
    {
      "job_name": "iot-ab",
      "sample_limit": 2000,
      "file_sd_configs": [
        {
          "files": [
            "/srv/iot-data/workspace/iot-maintenance-platform/data/runtime/monitoring-28/targets/ab-native-7.json",
            "/srv/iot-data/workspace/iot-maintenance-platform/data/runtime/monitoring-28/targets/ab-native-8.json"
          ],
          "refresh_interval": "2s"
        }
      ],
      "metric_relabel_configs": [
        {
          "source_labels": [
            "__name__"
          ],
          "regex": "iot_ab_.*",
          "action": "keep"
        }
      ]
    },
    {
      "job_name": "iot-api",
      "scrape_interval": "2s",
      "scrape_timeout": "2s",
      "metrics_path": "/telemetry/metrics",
      "sample_limit": 10000,
      "kubernetes_sd_configs": [
        {
          "role": "pod",
          "api_server": "https://10.53.0.1:443",
          "authorization": {
            "credentials_file": "/srv/iot-data/workspace/iot-maintenance-platform/data/runtime/api-observability-28b/prometheus-auth/token"
          },
          "tls_config": {
            "ca_file": "/srv/iot-data/workspace/iot-maintenance-platform/data/runtime/api-observability-28b/prometheus-auth/ca.crt"
          },
          "namespaces": {
            "names": [
              "iot-features"
            ]
          },
          "selectors": [
            {
              "role": "pod",
              "label": "app.kubernetes.io/instance in (iot-feature-api,iot-drift-api)"
            }
          ]
        },
        {
          "role": "pod",
          "api_server": "https://10.53.0.1:443",
          "authorization": {
            "credentials_file": "/srv/iot-data/workspace/iot-maintenance-platform/data/runtime/api-observability-28b/prometheus-auth/token"
          },
          "tls_config": {
            "ca_file": "/srv/iot-data/workspace/iot-maintenance-platform/data/runtime/api-observability-28b/prometheus-auth/ca.crt"
          },
          "namespaces": {
            "names": [
              "iot-serving"
            ]
          },
          "selectors": [
            {
              "role": "pod",
              "label": "serving.kserve.io/inferenceservice=iot-pump-serve-jenkins-8"
            }
          ]
        }
      ],
      "relabel_configs": [
        {
          "source_labels": [
            "__meta_kubernetes_pod_phase"
          ],
          "regex": "Running",
          "action": "keep"
        },
        {
          "source_labels": [
            "__meta_kubernetes_pod_ready"
          ],
          "regex": "true",
          "action": "keep"
        },
        {
          "source_labels": [
            "__meta_kubernetes_pod_container_init"
          ],
          "regex": "true",
          "action": "drop"
        },
        {
          "source_labels": [
            "__meta_kubernetes_pod_container_name"
          ],
          "regex": "api|kserve-container",
          "action": "keep"
        },
        {
          "source_labels": [
            "__meta_kubernetes_pod_container_port_number"
          ],
          "regex": "8080",
          "action": "keep"
        },
        {
          "source_labels": [
            "__meta_kubernetes_namespace"
          ],
          "target_label": "namespace"
        },
        {
          "source_labels": [
            "__meta_kubernetes_pod_name"
          ],
          "target_label": "pod"
        },
        {
          "source_labels": [
            "__meta_kubernetes_pod_uid"
          ],
          "target_label": "pod_uid"
        }
      ]
    }
  ]
}
