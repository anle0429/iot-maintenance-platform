{
  "id": null,
  "uid": "iot-offline-drift",
  "title": "IoT offline drift / simulated replay",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "5s",
  "description": "Airflow reads immutable Feast offline features. Simulated windows after train; no labels, accuracy or automatic promotion. Pushgateway retains old gauges: inspect wall-clock freshness.",
  "tags": [
    "iot",
    "drift",
    "offline-replay"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "PSI by feature (fixed train reference)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "iot_offline_drift_psi{job=\"iot_offline_drift\"}",
          "legendFormat": "{{feature}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Features flagged by declared policy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "iot_offline_drift_feature_alert{job=\"iot_offline_drift\"}",
          "legendFormat": "{{feature}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Unique snapshots sampled",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "iot_offline_drift_sample_rows{job=\"iot_offline_drift\"}",
          "legendFormat": "{{feature}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Seconds since successful comparison",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-iot_offline_drift_last_success_seconds{job=\"iot_offline_drift\"}",
          "legendFormat": "{{feature}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "SIMULATED window start",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "iot_offline_drift_window_start_seconds{job=\"iot_offline_drift\"}",
          "legendFormat": "{{feature}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "SIMULATED window end (exclusive)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "iot_offline_drift_window_end_seconds{job=\"iot_offline_drift\"}",
          "legendFormat": "{{feature}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    }
  ]
}
