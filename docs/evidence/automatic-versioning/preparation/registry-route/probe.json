{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "iot-registry-route-oracle-27-v4",
    "namespace": "kubeflow"
  },
  "spec": {
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 120,
    "automountServiceAccountToken": false,
    "securityContext": {
      "runAsUser": 10001,
      "runAsGroup": 10001,
      "runAsNonRoot": true,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "probe",
        "image": "iot-coursework-feast:0.67.0",
        "imagePullPolicy": "Never",
        "command": [
          "python",
          "-c",
          "import urllib.request,json;assert urllib.request.urlopen('http://tracking:5000/health',timeout=5).status==200;v=json.load(urllib.request.urlopen('http://tracking:5000/api/2.0/mlflow/runs/get?run_id=49ea21884b9048efb051db5150cff842',timeout=5));assert v['run']['info']['status']=='FINISHED';print('PASS native private registry health and completed data run')"
        ],
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "128Mi"
          },
          "limits": {
            "cpu": "500m",
            "memory": "256Mi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        }
      }
    ]
  }
}
