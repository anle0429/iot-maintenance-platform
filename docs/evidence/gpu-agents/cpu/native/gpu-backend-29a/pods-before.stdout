                "uid": "16fab042-76a2-4855-bbdd-a3e8d3d02a15"
            },
            "spec": {
                "containers": [
                    {
                        "command": [
                            "/bin/sh",
                            "-c",
                            "set -e\nfor i in $(seq 1 60); do\n  if aws s3api head-bucket --bucket ate-snapshots 2\u003e/dev/null; then\n    echo \"bucket ate-snapshots already exists\"\n    exit 0\n  fi\n  if aws s3api create-bucket --bucket ate-snapshots 2\u003e/dev/null; then\n    echo \"bucket ate-snapshots created\"\n    exit 0\n  fi\n  echo \"waiting for rustfs to become available... ($i/60)\"\n  sleep 2\ndone\necho \"timed out waiting for rustfs\"\nexit 1\n"
                        ],
                        "env": [
                            {
                                "name": "AWS_ACCESS_KEY_ID",
                                "valueFrom": {
                                    "secretKeyRef": {
                                        "key": "access",
                                        "name": "iot-substrate-object-store"
                                    }
                                }
                            },
                            {
                                "name": "AWS_SECRET_ACCESS_KEY",
                                "valueFrom": {
                                    "secretKeyRef": {
                                        "key": "secret",
                                        "name": "iot-substrate-object-store"
                                    }
                                }
                            },
                            {
                                "name": "AWS_REGION",
                                "value": "us-east-1"
                            },
                            {
                                "name": "AWS_ENDPOINT_URL",
                                "value": "http://rustfs.ate-system.svc:9000"
                            }
                        ],
                        "image": "amazon/aws-cli:2.17.0@sha256:643507c10ada7964ca6157b3d799f030b90577643da9955d319a77399ed80d73",
