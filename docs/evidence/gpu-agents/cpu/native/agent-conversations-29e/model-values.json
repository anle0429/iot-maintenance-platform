{
  "argo-rollouts-agent": {
    "enabled": false
  },
  "cilium-debug-agent": {
    "enabled": false
  },
  "cilium-manager-agent": {
    "enabled": false
  },
  "cilium-policy-agent": {
    "enabled": false
  },
  "controller": {
    "a2aClientTimeout": "1800s",
    "env": [
      {
        "name": "SSL_CERT_FILE",
        "value": "/etc/ate-ca/ca.crt"
      }
    ],
    "podLabels": {
      "iot.coursework/agent-control": "true"
    },
    "resources": {
      "limits": {
        "cpu": "1",
        "memory": "768Mi"
      },
      "requests": {
        "cpu": "100m",
        "memory": "128Mi"
      }
    },
    "substrate": {
      "ateApiEndpoint": "dns:///api.ate-system.svc:443",
      "ateApiInsecure": false,
      "atenetRouterURL": "http://atenet-router.ate-system.svc:80",
      "defaultWorkerPool": {
        "name": "iot-coordinator-pool",
        "namespace": "iot-agents"
      },
      "enabled": true
    },
    "volumeMounts": [
      {
        "mountPath": "/credentials/database",
        "name": "database-url",
        "readOnly": true
      },
      {
        "mountPath": "/etc/ate-ca",
        "name": "substrate-ca",
        "readOnly": true
      }
    ],
    "volumes": [
      {
        "name": "database-url",
        "secret": {
          "defaultMode": 292,
          "secretName": "iot-kagent-database"
        }
      },
      {
        "configMap": {
          "name": "iot-substrate-ca"
        },
        "name": "substrate-ca"
      }
    ],
    "watchNamespaces": [
      "iot-agents"
    ]
  },
  "database": {
    "postgres": {
      "bundled": {
        "enabled": false
      },
      "urlFile": "/credentials/database/url",
      "vectorEnabled": false
    }
  },
  "grafana-mcp": {
    "enabled": false
  },
  "helm-agent": {
    "enabled": false
  },
  "istio-agent": {
    "enabled": false
  },
  "k8s-agent": {
    "enabled": false
  },
  "kagent-tools": {
    "enabled": false
  },
  "kgateway-agent": {
    "enabled": false
  },
  "kmcp": {
    "enabled": false
  },
  "oauth2-proxy": {
    "enabled": false
  },
  "observability-agent": {
    "enabled": false
  },
  "promql-agent": {
    "enabled": false
  },
  "providers": {
    "default": "openAI",
    "openAI": {
      "apiKeySecretKey": "API_KEY",
      "apiKeySecretRef": "iot-local-model-client",
      "config": {
        "apiFormat": "chatCompletions",
        "baseUrl": "http://iot-router-epp.iot-llm.svc.cluster.local:8081/v1",
        "maxTokens": 768,
        "seed": 7,
        "temperature": "0",
        "timeout": 600
      },
      "model": "iot-qwen2.5-7b",
      "provider": "OpenAI"
    }
  },
  "rbac": {
    "namespaces": [
      "iot-agents"
    ]
  },
  "substrate": {
    "enabled": false
  },
  "ui": {
    "podLabels": {
      "iot.coursework/agent-control": "true"
    },
    "resources": {
      "limits": {
        "cpu": "500m",
        "memory": "512Mi"
      },
      "requests": {
        "cpu": "50m",
        "memory": "128Mi"
      }
    }
  }
}
