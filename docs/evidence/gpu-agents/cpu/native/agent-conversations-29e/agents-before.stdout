        {
            "apiVersion": "kagent.dev/v1alpha2",
            "kind": "SandboxAgent",
            "metadata": {
                "annotations": {
                    "iot.coursework/response-policy-sha256": "9360666ef663888ff775fff1fce13fd9559279ed96163059e312b7d38c41a2ab",
                    "meta.helm.sh/release-name": "iot-agents",
                    "meta.helm.sh/release-namespace": "iot-agents"
