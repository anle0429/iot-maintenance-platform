[
  "docker",
  "run",
  "--name",
  "iot-sensor-drift-small-27-v2",
  "--memory",
  "6g",
  "--cpus",
  "2",
  "--user",
  "185:10001",
  "--read-only",
  "--cap-drop",
  "ALL",
  "--network",
  "none",
  "--tmpfs",
  "/tmp:size=256m",
  "-e",
  "SPARK_LOCAL_IP=127.0.0.1",
  "-e",
  "PYSPARK_PYTHON=python3",
  "-e",
  "PYTHONPATH=/workspace",
  "-v",
  "/srv/iot-data/workspace/iot-maintenance-platform/generator:/workspace/generator:ro",
  "-v",
  "/srv/iot-data/workspace/iot-maintenance-platform/pipelines:/workspace/pipelines:ro",
  "-v",
  "/srv/iot-data/workspace/iot-maintenance-platform/ml:/workspace/ml:ro",
  "-v",
  "/srv/iot-data/workspace/iot-maintenance-platform/scripts:/workspace/scripts:ro",
  "-v",
  "/srv/iot-data/workspace/iot-maintenance-platform/data/drift/generator-27-v2:/drift-output",
  "-v",
  "/srv/iot-data/workspace/iot-maintenance-platform/data/drift/spark-scratch-27-v2:/scratch",
  "iot-coursework-spark:3.5.9",
  "--master",
  "local[2]",
  "--driver-memory",
  "2g",
  "--conf",
  "spark.driver.extraJavaOptions=-Dorg.xerial.snappy.tempdir=/scratch",
  "--conf",
  "spark.sql.shuffle.partitions=8",
  "--conf",
  "spark.sql.session.timeZone=UTC",
  "--conf",
  "spark.local.dir=/scratch",
  "scripts/verify-sensor-drift.py",
  "--config",
  "/workspace/generator/configs/sensor-drift-small.json",
  "--output",
  "/drift-output/sensor-small-27"
]
