{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "iot-log-discovery-probe",
    "namespace": "iot-features"
  },
  "spec": {
    "replicas": 1,
    "strategy": {
      "type": "Recreate"
    },
    "selector": {
      "matchLabels": {
        "app": "iot-log-discovery-probe"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "iot-log-discovery-probe"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "probe",
            "image": "iot-coursework-predictor:observe-jenkins-2",
            "imagePullPolicy": "Never",
            "command": [
              "python",
              "-c",
              "import json,os,time;[print(json.dumps({'experiment':'iot-log-discovery-28','batch':os.environ['BATCH'],'sequence':i,'pod_uid':os.environ['POD_UID']}),flush=True) for i in range(20)];time.sleep(10800)"
            ],
            "env": [
              {
                "name": "BATCH",
                "value": "second"
              },
              {
                "name": "POD_UID",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "metadata.uid"
                  }
                }
              }
            ],
            "resources": {
              "requests": {
                "cpu": "10m",
                "memory": "32Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "128Mi"
              }
            },
            "securityContext": {
              "readOnlyRootFilesystem": true,
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
