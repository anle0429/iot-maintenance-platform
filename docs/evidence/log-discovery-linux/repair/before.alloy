logging { level = "info" }

loki.write "local" {
  endpoint { url = "http://127.0.0.1:13100/loki/api/v1/push" }
}

loki.source.file "host_0" {
  targets = [{__path__ = "/srv/iot-data/workspace/iot-maintenance-platform/outputs/linux-monitoring-28/node-exporter.txt", host = "vm-linux", collection = "native-28-auto", service = "node-exporter", source = "host-file"}]
  forward_to = [loki.process.host_0.receiver]
}
loki.process "host_0" {
  forward_to = [loki.relabel.paths.receiver]
  stage.logfmt { mapping = { event_time = "time", level = "level" } }
  stage.timestamp {
    source = "event_time"
    format = "RFC3339Nano"
    action_on_failure = "skip"
    action_on_duplicate_timestamp = "keep"
  }
  stage.labels { values = { level = "" } }
}

loki.source.file "host_1" {
  targets = [{__path__ = "/srv/iot-data/workspace/iot-maintenance-platform/outputs/linux-monitoring-28/prometheus.txt", host = "vm-linux", collection = "native-28-auto", service = "prometheus", source = "host-file"}]
  forward_to = [loki.process.host_1.receiver]
}
loki.process "host_1" {
  forward_to = [loki.relabel.paths.receiver]
  stage.logfmt { mapping = { event_time = "time", level = "level" } }
  stage.timestamp {
    source = "event_time"
    format = "RFC3339Nano"
    action_on_failure = "skip"
    action_on_duplicate_timestamp = "keep"
  }
  stage.labels { values = { level = "" } }
}

loki.source.file "host_2" {
  targets = [{__path__ = "/srv/iot-data/workspace/iot-maintenance-platform/outputs/linux-monitoring-28/grafana.txt", host = "vm-linux", collection = "native-28-auto", service = "grafana", source = "host-file"}]
  forward_to = [loki.process.host_2.receiver]
}
loki.process "host_2" {
  forward_to = [loki.relabel.paths.receiver]
  stage.logfmt { mapping = { event_time = "t", level = "level" } }
  stage.timestamp {
    source = "event_time"
    format = "RFC3339Nano"
    action_on_failure = "skip"
    action_on_duplicate_timestamp = "keep"
  }
  stage.labels { values = { level = "" } }
}

discovery.kubernetes "applications" {
  role = "pod"
  api_server = "https://10.53.0.1:443"
  bearer_token_file = "/srv/iot-data/workspace/iot-maintenance-platform/data/runtime/log-discovery-28/auth/token"
  tls_config { ca_file = "/srv/iot-data/workspace/iot-maintenance-platform/data/runtime/log-discovery-28/auth/ca.crt" }
  namespaces { names = ["iot-features", "iot-serving"] }
  selectors {
    role = "pod"
    field = "spec.nodeName=iot-cw-vm"
  }
}
discovery.relabel "applications" {
  targets = discovery.kubernetes.applications.targets
  rule {
    source_labels = ["__meta_kubernetes_pod_container_init"]
    regex = "false"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex = "Running"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_instance"]
    regex = "iot-feature-api"
    target_label = "service"
    replacement = "feature-api"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_instance"]
    regex = "iot-drift-api"
    target_label = "service"
    replacement = "drift-api"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_instance"]
    regex = "iot-ab-serve-jenkins-8"
    target_label = "service"
    replacement = "ab-api"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_serving_kserve_io_inferenceservice"]
    regex = "iot-pump-serve-jenkins-8"
    target_label = "service"
    replacement = "predictor"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    regex = "iot-log-discovery-probe"
    target_label = "service"
    replacement = "log-probe"
  }
  rule {
    source_labels = ["service"]
    regex = "feature-api|drift-api|ab-api|predictor|log-probe"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    regex = "api|kserve-container|probe"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_uid"]
    target_label = "pod_uid"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label = "container"
  }
  rule {
    source_labels = ["namespace", "pod", "pod_uid", "container"]
    separator = ";"
    regex = "(.+);(.+);(.+);(.+)"
    target_label = "__path__"
    replacement = "/var/log/pods/$1_$2_$3/$4/*.log"
  }
  rule {
    target_label = "host"
    replacement = "vm-linux"
  }
  rule {
    target_label = "collection"
    replacement = "native-28-auto"
  }
  rule {
    target_label = "source"
    replacement = "cri"
  }
  rule {
    action = "labelkeep"
    regex = "__path__|host|collection|source|service|namespace|pod|pod_uid|container"
  }
}
local.file_match "applications" {
  path_targets = discovery.relabel.applications.output
  sync_period = "5s"
}
loki.source.file "applications_auto" {
  targets = local.file_match.applications.targets
  forward_to = [loki.process.applications.receiver]
}
loki.process "applications" {
  forward_to = [loki.relabel.paths.receiver]
  stage.cri {}
}
loki.relabel "paths" {
  forward_to = [loki.write.local.receiver]
  rule {
    action = "labeldrop"
    regex = "filename"
  }
}
