      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "nginx-config",
        "namespace": "iot-gateway"
      },
      "data": {
        "ssl-protocols": "TLSv1.2 TLSv1.3",
        "ssl-redirect": "true",
        "http-redirect-code": "308",
        "server-tokens": "false",
        "worker-processes": "1",
        "log-format-escaping": "json",
        "log-format": "$time_iso8601 $host $status $request_method $uri"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "iot-gateway",
        "namespace": "iot-gateway"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "iot-gateway"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "iot-gateway"
            }
          },
          "spec": {
            "serviceAccountName": "iot-gateway",
            "securityContext": {
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "controller",
                "image": "nginx/nginx-ingress@sha256:cf6a49ddb69065d17aded929b04ac0fa98525950ccfb98ce4723517edf6d3050",
                "imagePullPolicy": "IfNotPresent",
                "args": [
                  "-ingress-class=iot-gateway",
                  "-watch-namespace=iot-gateway,iot-features,iot-observability",
                  "-enable-custom-resources=false",
                  "-enable-leader-election=false",
                  "-enable-telemetry-reporting=false",
                  "-nginx-configmaps=iot-gateway/nginx-config",
                  "-nginx-status=false"
                ],
                "env": [
                  {
                    "name": "POD_NAMESPACE",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.namespace"
                      }
                    }
                  },
                  {
                    "name": "POD_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.name"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 80
                  },
                  {
                    "name": "https",
                    "containerPort": 443
                  },
                  {
                    "name": "ready",
                    "containerPort": 8081
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/nginx-ready",
                    "port": "ready"
                  },
                  "periodSeconds": 2
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "runAsUser": 101,
                  "runAsNonRoot": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ],
                    "add": [
                      "NET_BIND_SERVICE"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
