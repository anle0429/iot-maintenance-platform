[
  "docker",
  "run",
  "--name",
  "iot-staged-stream-native-28",
  "--network",
  "host",
  "--memory",
  "4g",
  "--memory-swap",
  "4g",
  "--cpus",
  "1",
  "--pids-limit",
  "256",
  "--cap-drop",
  "ALL",
  "--security-opt",
  "no-new-privileges",
  "--read-only",
  "--tmpfs",
  "/tmp:size=128m,mode=1777",
  "--env",
  "IOT_FEAST_REDIS=10.53.55.207:6379",
  "--mount",
  "type=bind,src=/srv/iot-data/workspace/iot-maintenance-platform/outputs/staged-stream-native-28/work,dst=/workspace/checks",
  "iot-ci-stream-push:staged-native-28",
  "-m",
  "feature_store.staged_checks",
  "--operation",
  "sequence",
  "--state",
  "/workspace/checks/phases",
  "--source-id",
  "staged-native-28",
  "--output",
  "/workspace/checks/verification.json"
]
