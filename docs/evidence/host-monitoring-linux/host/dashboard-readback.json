  "dashboard": {
    "description": "Actual host-wide metrics, including other applications.30s rates require15samples at2s intervals; they use boundary extrapolation. Virtual NICs can double-count traffic. No per-job attribution, benchmark, VM deployment or model-quality claim.",
    "editable": false,
    "id": 3064457554907136,
    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "iot-host-prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "max": 100,
            "min": 0,
            "unit": "percent"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 7,
          "w": 8,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "targets": [
          {
            "expr": "(100 * (1 - avg by (host) (rate(node_cpu_seconds_total{job=\"iot-host\",host=\"$host\",mode=\"idle\"}[30s])))) and on (host) (min by (host) (count_over_time(node_cpu_seconds_total{job=\"iot-host\",host=\"$host\",mode=\"idle\"}[30s])) >= 15)",
            "legendFormat": "{{host}} busy",
            "refId": "A"
          }
        ],
        "title": "CPU non-idle / all logical cores",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "iot-host-prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "max": 100,
            "min": 0,
            "unit": "percent"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 7,
          "w": 8,
          "x": 8,
          "y": 0
        },
        "id": 2,
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "targets": [
          {
            "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"iot-host\",host=\"$host\"} / node_memory_MemTotal_bytes{job=\"iot-host\",host=\"$host\"})",
            "legendFormat": "{{host}} RAM",
            "refId": "A"
          }
        ],
        "title": "RAM unavailable / total",
        "type": "timeseries"
      },
      {
        "datasource": {
