            "apiVersion": "v1",
            "kind": "Pod",
            "metadata": {
                "creationTimestamp": "2026-10-29T06:21:52Z",
                "generateName": "rustfs-bucket-init-",
                "generation": 1,
                "labels": {
                    "batch.kubernetes.io/controller-uid": "16d61926-8055-4857-8417-4eaa8a272f04",
                    "batch.kubernetes.io/job-name": "rustfs-bucket-init",
                    "controller-uid": "16d61926-8055-4857-8417-4eaa8a272f04",
                    "job-name": "rustfs-bucket-init"
                },
