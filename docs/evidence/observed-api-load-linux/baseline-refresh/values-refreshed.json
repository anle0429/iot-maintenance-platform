{
  "autoscaling": {
    "enabled": true,
    "maxReplicas": 2,
    "minReplicas": 1,
    "targetCPUUtilizationPercentage": 60
  },
  "env": [
    {
      "name": "IOT_FEAST_REDIS",
      "value": "online-serve-jenkins-8.iot-features.svc.cluster.local:6379"
    },
    {
      "name": "IOT_SERVING_STATE",
      "value": "/state"
    },
    {
      "name": "IOT_KSERVE_URL",
      "value": "http://iot-pump-serve-jenkins-8-predictor.iot-serving.svc.cluster.local"
    },
    {
      "name": "IOT_MODEL_PIN",
      "value": "/app/model-pin.json"
    },
    {
      "name": "IOT_API_SERVICE",
      "value": "feature"
    },
    {
      "name": "IOT_TRACE_ENDPOINT",
      "value": "http://iot-jaeger.iot-observability.svc.cluster.local:4318/v1/traces"
    }
  ],
  "image": {
    "pullPolicy": "Never",
    "repository": "iot-coursework-feature-api",
    "tag": "observe-28b-v2"
  },
  "initContainers": [
    {
      "command": [
        "python",
        "-c",
        "import shutil,pathlib; p=pathlib.Path('/state/registry'); p.mkdir(); [shutil.copyfile('/seed/'+n,'/state/'+n) for n in ['context.json','verification.json','_READY.json']]; shutil.copyfile('/seed/registry.db','/state/registry/registry.db')"
      ],
      "image": "iot-coursework-feature-api:observe-28b-v2",
      "imagePullPolicy": "Never",
      "name": "copy-state",
      "resources": {
        "limits": {
          "cpu": "500m",
          "memory": "256Mi"
        },
        "requests": {
          "cpu": "50m",
          "memory": "64Mi"
        }
      },
      "securityContext": {
        "allowPrivilegeEscalation": false,
        "capabilities": {
          "drop": [
            "ALL"
          ]
        },
        "readOnlyRootFilesystem": true
      },
      "volumeMounts": [
        {
          "mountPath": "/seed",
          "name": "seed",
          "readOnly": true
        },
        {
          "mountPath": "/state",
          "name": "state"
        }
      ]
    }
  ],
  "replicas": 1,
  "resources": {
    "limits": {
      "cpu": "1",
      "memory": "1Gi"
    },
    "requests": {
      "cpu": "100m",
      "memory": "256Mi"
    }
  },
  "revisionMarker": "observability-load-28c",
  "volumeMounts": [
    {
      "mountPath": "/state",
      "name": "state"
    },
    {
      "mountPath": "/tmp",
      "name": "tmp"
    }
  ],
  "volumes": [
    {
      "configMap": {
        "name": "iot-feature-observability-load-28c"
      },
      "name": "seed"
    },
    {
      "emptyDir": {
        "medium": "Memory",
        "sizeLimit": "16Mi"
      },
      "name": "state"
    },
    {
      "emptyDir": {
        "medium": "Memory",
        "sizeLimit": "32Mi"
      },
      "name": "tmp"
    }
  ]
}
