{
  "uid": "iot-linux-logs",
  "title": "IoT logs / Linux host and APIs",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "description": "Observed host stdout files and explicitly named Kubernetes CRI files. Original log timestamps when parseable; otherwise arrival time. No model-quality or trace claims.",
  "timezone": "utc",
  "refresh": "5s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "tags": [
    "iot",
    "logs",
    "linux"
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "constant",
        "query": "vm-linux",
        "current": {
          "text": "vm-linux",
          "value": "vm-linux"
        },
        "hide": 0
      },
      {
        "name": "collection",
        "type": "constant",
        "query": "native-28-keep",
        "current": {
          "text": "native-28-keep",
          "value": "native-28-keep"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Lines by service",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "iot-logs-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({host=\"$host\",collection=\"$collection\"}[1m]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{service}} {{stream}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Application output streams",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "iot-logs-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service,stream) (count_over_time({host=\"$host\",collection=\"$collection\",source=\"cri\"}[1m]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{service}} {{stream}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Host service logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "iot-logs-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=\"$host\",collection=\"$collection\",source=\"host-file\"}",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{service}} {{stream}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 16
      },
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Application logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "iot-logs-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=\"$host\",collection=\"$collection\",source=\"cri\"}",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{service}} {{stream}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 16
      },
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
