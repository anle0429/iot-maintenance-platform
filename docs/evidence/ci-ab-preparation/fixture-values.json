{
  "image": {
    "repository": "iot-coursework-ab-api",
    "tag": "serve-jenkins-7",
    "pullPolicy": "Never"
  },
  "replicas": 1,
  "autoscaling": {
    "enabled": false
  },
  "resources": {
    "requests": {
      "cpu": "100m",
      "memory": "256Mi"
    },
    "limits": {
      "cpu": "1",
      "memory": "2Gi"
    }
  },
  "env": [
    {
      "name": "IOT_FEAST_REDIS",
      "value": "online-serve-jenkins-7.iot-features.svc.cluster.local:6379"
    },
    {
      "name": "IOT_AB_CONFIG",
      "value": "/config/config.json"
    },
    {
      "name": "IOT_SERVING_STATE",
      "value": "/state"
    },
    {
      "name": "IOT_DRIFT_REFERENCE",
      "value": "/reference/reference.json"
    },
    {
      "name": "IOT_AB_DATABASE",
      "value": "/ledger/trials.sqlite"
    }
  ],
  "initContainers": [
    {
      "name": "copy-state",
      "image": "iot-coursework-ab-api:serve-jenkins-7",
      "imagePullPolicy": "Never",
      "command": [
        "python",
        "-c",
        "import shutil,pathlib; p=pathlib.Path('/state/registry'); p.mkdir(); [shutil.copyfile('/seed/'+n,'/state/'+n) for n in ['context.json','verification.json','_READY.json']]; shutil.copyfile('/seed/registry.db','/state/registry/registry.db')"
      ],
      "resources": {
        "requests": {
          "cpu": "50m",
          "memory": "64Mi"
        },
        "limits": {
          "cpu": "500m",
          "memory": "256Mi"
        }
      },
      "securityContext": {
        "allowPrivilegeEscalation": false,
        "readOnlyRootFilesystem": true,
        "capabilities": {
          "drop": [
            "ALL"
          ]
        }
      },
      "volumeMounts": [
        {
          "name": "seed",
          "mountPath": "/seed",
          "readOnly": true
        },
        {
          "name": "state",
          "mountPath": "/state"
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "config",
      "configMap": {
        "name": "iot-ab-serve-jenkins-7-config"
      }
    },
    {
      "name": "seed",
      "configMap": {
        "name": "iot-feature-state-serve-jenkins-7"
      }
    },
    {
      "name": "reference",
      "configMap": {
        "name": "iot-ab-serve-jenkins-7-reference"
      }
    },
    {
      "name": "state",
      "emptyDir": {
        "medium": "Memory",
        "sizeLimit": "16Mi"
      }
    },
    {
      "name": "ledger",
      "persistentVolumeClaim": {
        "claimName": "iot-ab-serve-jenkins-7-ledger"
      }
    },
    {
      "name": "tmp",
      "emptyDir": {
        "medium": "Memory",
        "sizeLimit": "32Mi"
      }
    }
  ],
  "volumeMounts": [
    {
      "name": "config",
      "mountPath": "/config",
      "readOnly": true
    },
    {
      "name": "reference",
      "mountPath": "/reference",
      "readOnly": true
    },
    {
      "name": "state",
      "mountPath": "/state"
    },
    {
      "name": "ledger",
      "mountPath": "/ledger"
    },
    {
      "name": "tmp",
      "mountPath": "/tmp"
    }
  ],
  "revisionMarker": "serve-jenkins-7"
}
