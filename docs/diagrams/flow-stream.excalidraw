    {
      "id": "stream-limits",
      "type": "text",
      "x": 60,
      "y": 1240,
      "width": 1250.390625,
      "height": 220,
      "fontSize": 22,
      "strokeColor": "#374151",
      "text": "Corrected: 15-minute watermark delay; ten-minute tumbling windows; no allowed-lateness extension.\nBaseline disables dedup and uses zero watermark delay; it is an intentional comparison.\nCache expiry uses processing-time timers; a durable ledger prevents re-counting after expiry.\nSQLite sink/ledger writes are not checkpoint-transactional: no general exactly-once claim.\nNative 5,760-window and small CI/Airflow demonstrations are separate bounded runs.\nAcknowledged writer replay skips counts/writes/TTL renewal; old windows cannot regress state.\nThe four stream fields above are independent from the eight rolling prediction inputs.\nSources: pipelines/stream_job.py, stream_contract.py; feature_store/staged_push.py.",
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "seed": 672132175,
      "version": 1,
      "versionNonce": 856315559,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "link": null,
      "locked": false,
      "updated": 1,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "containerId": null,
      "originalText": "Corrected: 15-minute watermark delay; ten-minute tumbling windows; no allowed-lateness extension.\nBaseline disables dedup and uses zero watermark delay; it is an intentional comparison.\nCache expiry uses processing-time timers; a durable ledger prevents re-counting after expiry.\nSQLite sink/ledger writes are not checkpoint-transactional: no general exactly-once claim.\nNative 5,760-window and small CI/Airflow demonstrations are separate bounded runs.\nAcknowledged writer replay skips counts/writes/TTL renewal; old windows cannot regress state.\nThe four stream fields above are independent from the eight rolling prediction inputs.\nSources: pipelines/stream_job.py, stream_contract.py; feature_store/staged_push.py.",
      "autoResize": true,
      "index": "al",
      "backgroundColor": "transparent"
    }
