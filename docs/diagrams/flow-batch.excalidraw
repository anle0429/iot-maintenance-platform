    {
      "id": "batch-limits",
      "type": "text",
      "x": 60,
      "y": 1410,
      "width": 1263.28125,
      "height": 137.5,
      "fontSize": 22,
      "strokeColor": "#374151",
      "text": "DP1-DP3: bounded source-bound jobs; immutable outputs, persisted-data checks, then release.\nLarge-source processing ends at Silver; feature engineering/ML use a separate 60-day cohort.\nProduction dedup keeps the window selector; the slower aggregate candidate was not promoted.\nSolid: data files. Dashed: orchestration/metadata. Parquet joins do not enforce SQL foreign keys.\nSources: generator/, pipelines/, airflow/dags/; arrow details link the exact implementation files.",
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "seed": 1895207114,
