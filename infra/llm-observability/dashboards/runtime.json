{
  "uid": "iot-llm-runtime",
  "title": "IoT / LLM and agent operations",
  "description": "Actual observer, per-Pod MCP and llama.cpp series. SDK UNSET remains unset; provider-reported usage is not estimated from characters.",
  "schemaVersion": 42,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "tags": [
    "iot",
    "llm",
    "native"
  ],
  "refresh": "5s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Read these measurements correctly",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Requests, executor invocations and spans count different things. **UNSET is not success.** MCP counters include their retained earlier history; use rate/increase for a selected interval. Proxy role **unknown** stays unknown. Token and timing facts for each request are in the linked request log. Existing unrelated target failures remain visible."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Seven LLM monitoring targets",
      "description": "Each Pod is discovered independently, including running Pods that are not ready.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"iot-agent-mcp|iot-llm-observer|iot-llm-model|iot-llm-gpu-host\"}",
          "editorMode": "code",
          "legendFormat": "{{job}} / {{pod}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "All monitoring targets",
      "description": "Includes existing unrelated ML failures; no target is hidden to make this view green.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "editorMode": "code",
          "legendFormat": "{{job}} / {{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Observer HTTP requests / second",
      "description": "Includes real route/status; health and metrics traffic are visible separately.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route,status) (rate(iot_llm_observer_http_requests_total[1m]))",
          "editorMode": "code",
          "legendFormat": "{{route}} HTTP {{status}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Model requests by actual outcome",
      "description": "Durable observed model requests, including rejected requests.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result,status) (iot_llm_requests_total)",
          "editorMode": "code",
          "legendFormat": "{{result}} HTTP {{status}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Full model round trip: mean",
      "description": "Observer admission through complete backend consumption; not GPU compute time alone.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(iot_llm_request_seconds_sum[5m])) / sum(rate(iot_llm_request_seconds_count[5m]))",
          "editorMode": "code",
          "legendFormat": "mean",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Streaming first output: mean",
      "description": "Only observed streaming replies. Idle windows may have no samples; nonstreaming TTFT is null.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(iot_llm_first_output_seconds_sum[5m])) / sum(rate(iot_llm_first_output_seconds_count[5m]))",
          "editorMode": "code",
          "legendFormat": "mean TTFT",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Provider-reported token totals",
      "description": "Input, output and total are separate series; total already includes input and output.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
