{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "sourceCommit", "gpuNode", "controlSourceAddresses"],
  "properties": {
    "image": {"type": "string", "pattern": "^docker.io/library/iot-gpu-host-telemetry@sha256:[a-f0-9]{64}$"},
    "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "gpuNode": {"const": "iot-cw-gpu"},
    "controlSourceAddresses": {
      "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^10\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}/32$"}
    }
  }
}
