{
  "uid": "iot-llm-policy-window",
  "title": "IoT / Prompt policy window",
  "schemaVersion": 42,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "description": "Twelve controlled synthetic admissions. Unique blocked prompts, overlapping category hits and two frequency definitions are separate.",
  "tags": [
    "iot",
    "llm",
    "policy"
  ],
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Completed run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "iot-host-prometheus"
        },
        "refresh": 1,
        "query": {
          "query": "label_values(iot_llm_policy_window_admissions, run)",
          "refId": "run-list"
        },
        "current": {
          "text": "",
          "value": ""
        },
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Read this window correctly",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "A deliberately synthetic 12-prompt cohort: **3 allowed, 9 unique blocked prompts, 12 category hits**. The four-category prompt counts once as a blocked prompt.\n\nExact frequency = unique blocked requests / measured elapsed minutes. The graph uses **Prometheus rate over 1 minute**, with scrape extrapolation. Neither is production prevalence. These four text patterns are a bounded policy, not universal PII or safety detection."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "All admissions",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "iot_llm_policy_window_admissions{run=\"$run\"}",
          "legendFormat": "All admissions",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unique blocked prompts",
      "description": "",
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "iot_llm_policy_window_blocked_prompts{run=\"$run\"}",
          "legendFormat": "Unique blocked prompts",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Overlapping category hits",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "iot_llm_policy_window_category_hits_total{run=\"$run\"}",
          "legendFormat": "Overlapping category hits",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Measured window",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 4,
        "h": 6
