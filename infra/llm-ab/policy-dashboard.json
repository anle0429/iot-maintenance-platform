      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "iot_llm_policy_window_seconds{run=\"$run\"}",
          "legendFormat": "Measured window",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Exact blocked prompts / observed minute",
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "iot_llm_policy_window_blocked_per_minute{run=\"$run\"}",
          "legendFormat": "Exact blocked prompts / observed minute",
