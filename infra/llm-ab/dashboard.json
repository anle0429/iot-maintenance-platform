    {
      "id": 9,
      "type": "stat",
      "title": "Output tokens per measured reply",
      "description": "Interpret response latency alongside the actual reply length.",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "iot_llm_ab_output_tokens{run=\"$run\"} / iot_llm_ab_measured_requests{run=\"$run\"}",
          "legendFormat": "{{variant}}",
          "instant": true,
