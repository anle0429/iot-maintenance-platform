    },
    {
      "id": 8,
      "type": "stat",
      "title": "Provider-reported total tokens",
      "description": "Input plus output; do not add all three panels together.",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "iot-host-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "iot_llm_ab_total_tokens{run=\"$run\"}",
          "legendFormat": "{{variant}}",
