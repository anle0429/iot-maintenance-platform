# Preserve the existing MLflow server; the upstream is read from its actual private Docker address.
[Unit]
Description=Proxy the private K3s socket to existing local MLflow
Requires=iot-mlflow-bridge.socket
After=iot-mlflow-bridge.socket

[Service]
EnvironmentFile=/etc/iot-coursework/mlflow-bridge.env
ExecStart=/lib/systemd/systemd-socket-proxyd ${IOT_MLFLOW_UPSTREAM}
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=64M
CPUQuota=50%
RestrictAddressFamilies=AF_INET AF_UNIX
