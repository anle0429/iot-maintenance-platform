* text=auto
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.tf text eol=lf
*.hcl text eol=lf
*.tfvars.example text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.sql text eol=lf
**/Dockerfile text eol=lf
*.xlsx binary
*.png binary
*.jpg binary
*.parquet binary
# Preserve captured console spacing; source code still uses normal whitespace checks.
docs/evidence/**/*.txt -whitespace
# Keep captured Feast evidence and its installed dependency lock byte-identical.
docs/evidence/feast/** -text -whitespace
infra/feast/requirements.lock -text -whitespace
# Preserve native stream-push reports, console logs and historical source snapshots.
docs/evidence/stream-push/** -text -whitespace
